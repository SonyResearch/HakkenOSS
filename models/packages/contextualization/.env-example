# Example environment variables (do NOT commit real secrets).
# Copy this to .env and fill with real values for local development.

# MinIO (used by Milvus setup)
MINIO_ACCESS_KEY=__MINIO_ACCESS_KEY__
MINIO_SECRET_KEY=__MINIO_SECRET_KEY__

# Postgres
POSTGRES_USER=__POSTGRES_USER__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# Milvus (if applicable)
MILVUS_PASSWORD=__MILVUS_PASSWORD__

# Codeartifact / registry secrets (used during image build with secret mounts)
CODEARTIFACT_USERNAME=__CODEARTIFACT_USERNAME__
CODEARTIFACT_PASSWORD=__CODEARTIFACT_PASSWORD__
# Modify this file and save it to .env
MILVUS_URI="http://localhost:19530"
PUBLICATION_DATA_DIRECTORY="tests/test_data/publications"
