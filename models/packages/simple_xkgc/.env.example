# -------------------------
# Registry Credentials
# -------------------------
UV_INDEX_HAKKEN_PIP_REGISTRY_USERNAME=name.surname@sony.com
UV_INDEX_HAKKEN_PIP_REGISTRY_PASSWORD=PASSWORD_HERE

# -------------------------
# Versions (Optional)
# -------------------------
DATASET=pubtator3
DATA_VERSION=0.4.0
EXPLAINER_VERSION=1.1.0


# -------------------------
# Base paths (Optional)
# -------------------------
BASE_WORKSPACE=/home/name.surname/Documents/GitHub


# -------------------------
# Dataset / Cache directories (constructed from base + versions)
# -------------------------
# (Optional) Dataset-specific root (includes dataset name + version)
DATA_ROOT_FOLDER=${BASE_WORKSPACE}/data/hakken_bio/${DATASET}-v${DATA_VERSION}

# Cached artifacts used by experiments / training
CACHED_DATA_FOLDER=${DATA_ROOT_FOLDER}/cached/v${EXPLAINER_VERSION}
GRAPH_CACHE_FOLDER=${DATA_ROOT_FOLDER}/graph_cache/v${EXPLAINER_VERSION}




# -------------------------
# Local package / API paths
# -------------------------
# (Optional) Local python package (xkge API) used by experiments
XKGE_API_PACKAGE_DIR=${BASE_WORKSPACE}/project_spaice_ds/packages/pip/hakken_explainer_api

# Model outputs folder for a given GNN version
MODEL_FOLDER=${XKGE_API_PACKAGE_DIR}/outputs/prod/xkge-v${EXPLAINER_VERSION}

# Config directory inside the local package
CONFIG_PATH==${BASE_WORKSPACE}/project_spaice_ds/packages/pip/hakken_explainer/config