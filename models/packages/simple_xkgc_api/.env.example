# -------------------------
# Registry Credentials
# -------------------------
UV_INDEX_HAKKEN_PIP_REGISTRY_USERNAME=name.surname@sony.com
UV_INDEX_HAKKEN_PIP_REGISTRY_PASSWORD=YOUR_PASSWORD_HERE

# -------------------------
# Versions (Optional)
# -------------------------
DATASET=pubtator3
DATA_VERSION=0.2.0
EXPLAINER_VERSION=1.0.0

# -------------------------
# Base paths (Optional)
# -------------------------
BASE_WORKSPACE=/home/pablo.sanchez2/Documents/GitHub

# -------------------------
# Dataset / Cache directories (constructed from base + versions)
# -------------------------
# Dataset-specific root (includes dataset name + version)
DATA_ROOT_FOLDER=${BASE_WORKSPACE}/data/hakken_bio/${DATASET}-v${DATA_VERSION}

# Cached artifacts used by experiments / training
CACHED_DATA_FOLDER=${DATA_ROOT_FOLDER}/cached/v${EXPLAINER_VERSION}
GRAPH_CACHE_FOLDER=${DATA_ROOT_FOLDER}/graph_cache/v${EXPLAINER_VERSION}

# -------------------------
# Local package / API paths
# -------------------------
# Local python package (xkge API) used by experiments
XKGE_API_PACKAGE_DIR=${BASE_WORKSPACE}/project_spaice_ds/packages/pip/simple_xkgc_api

# Model outputs folder for a given GNN version
MODEL_DIR=${XKGE_API_PACKAGE_DIR}/outputs/prod/xkge-v${EXPLAINER_VERSION}

# Config directory inside the local package
CONFIG_PATH=${XKGE_API_PACKAGE_DIR}/config

# -------------------------
# Service endpoints
# -------------------------
# Local explanation/path-explainer API used by scripts
EXPLAIN_API_ENDPOINT=http://localhost:8089/test/path_explainer/explain
