# ===== Temporal KG core =====
GRAPH_NAME=temporal_kg
BATCH_SIZE=10000

# ===== Ingest-only settings (used only during ingest) =====
# Leave these unset if you're not running an ingest operation
INGEST_NODES_FILE_PATH=/absolute/path/to/nodes.tsv
INGEST_EDGES_FILE_PATH=/absolute/path/to/edges.tsv
INGEST_RECREATE_GRAPH=true


# Optional: mapping from dataframe columns to graph property names (JSON)
# Remove or comment out if not needed
NODE_PROPERTIES='{"node_id":"node_id","node_name":"node_name"}'