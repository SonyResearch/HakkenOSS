# LLM
LLM_MODEL_NAME=tngtech/deepseek-r1t2-chimera:free
LLM_TEMPERATURE=0.2
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<OPENROUTER_API_KEY>

# Embedder
EMBEDDER_NAME=openai/text-embedding-3-small
EMBEDDER_DIM=1536
EMBEDDER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDER_API_KEY=<OPENROUTER_API_KEY>

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hakken_agents

# Element Resolver
TABLE_NAME=pubtator3-v0_4_0-nodes_vectors

# Documents (used by Hydra document configs, e.g. document=paris)
DOCS_FOLDER=/path/to/documents

